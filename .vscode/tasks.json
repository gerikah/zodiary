{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build debug APK",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": ["--no-daemon", ":app:assembleDebug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Android: Run unit tests",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": ["--no-daemon", ":app:testDebugUnitTest"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Install debug app on connected device",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": ["--no-daemon", ":app:installDebug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "problemMatcher": []
    }
  ]
}
